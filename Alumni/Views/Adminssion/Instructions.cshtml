
@{
    ViewBag.Title = "InstructionsForAdminission";
}
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width,user-scalable=no,initial-scale=1,minimum-scale=1,maximum-scale=1" />
    <meta name="viewport" content="user-scalable=no, initial-scale=1, maximum-scale=1, minimum-scale=1, width=device-width, height=device-height, target-densitydpi=device-dpi" />
    <title>KCISEC Alumni entering school notice | 康桥校友入校申请须知</title>
    <link href="~/css/list.css" rel="stylesheet" />
    <link href="~/css/new2.css" rel="stylesheet" />
    <script src="~/js/jquery1.min.js"></script>
</head>
<body>
   
    <div>
        <div id="banner" style="margin:0px;padding:0px;text-align:center" >
            <img src="~/img/logo_XY2.png"/>
        </div>
        <div>
            <h3 style="display: block;font-size: 1.17em;font-weight: bold">KCISEC Alumni entering school notice | 康桥校友入校申请须知</h3>
            <br />

            <b style="color:red;font: 14px;line-height: 2em;">[校友入校注意事项][Notes for alumni entering the school] </b><br />
            <b style="color: #333;font: 14px;line-height: 2em;">
                请联系您要拜访的老师，由老师填写学校访客申请单。<br />
                Please contact the teacher you want to visit, and the teacher will fill out the school visitor application form.
            </b>

            <br /> <br /> <br /> <br /> <br /> <br /> <br /> <br /> <br /> <br /> <br /> <br /> <br /> <br /> 

            <div class="butom" style="text-align:center;">
                <!--<a href="javascript:history.go(-1)" class="button">返回</a>  |-->
                <a href="~/Home/Index" class="button">
                    返回 Back
                </a> 
                @*<a href="~/Manager/ManagerIndex" class="button">教职员申请 Apply by faculty</a>*@
                @*<a class="button" id="btn_adminssion">教职员申请 Apply by faculty</a>*@
            </div>


        </div>
    </div>
</body>
<script type="text/javascript">
    $(function () {

        var cookies = document.cookie;
        const cookieMap = new Map();
        document.cookie.split("; ").forEach((cookie) => {
            const [key, value] = cookie.split("=");
            cookieMap.set(key, value);
        });

        $("#btn_adminssion").on("click", function () {
            var usergroup = decodeURIComponent(cookieMap.get("GroupName"));
            $("#username").html(decodeURIComponent(cookieMap.get("GroupName")) + "&nbsp;&nbsp;&nbsp;&nbsp;" + decodeURIComponent(cookieMap.get("fullname")));
            console.log(cookies);
            if (usergroup == "teacher") {
                var url = '@Url.Action("AdminssionApply", "Adminssion")';
                window.location.href = url;
            } else if (usergroup == "alumni") {
                alert("由教职员填写，校友无需填写。To be filled in by faculty and staff, alumni need not fill in")
            } else if (usergroup == null || usergroup == '') {
                alert("登录状态异常，请重新登录。Login status is abnormal, please log in again")
            }
        });
    });
</script>
